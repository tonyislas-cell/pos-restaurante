# Copia este archivo como ".env.local" y rellena con tus datos de Supabase.
# Los encuentras en: Supabase -> tu proyecto -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key

# Contraseña compartida para entrar al POS (MVP: acceso simple del local)
NEXT_PUBLIC_POS_PASSWORD=cambia-esta-clave
